local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- CONFIGURATION
local LOGO_ID = "104457688401830"

local cursors = {
    {
        Name = "Diamond Sword",
        ID = "99371372225483"
    },
    {
        Name = "White Cross",
        ID = "94056530967449"
    }
}

local originalCursor = mouse.Icon
local originalMouseEnabled = UIS.MouseIconEnabled
local selectedCursor = nil

--========================================
-- SCREEN GUI
--========================================

local gui = Instance.new("ScreenGui")
gui.Name = "SHAGS_HUB"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

--========================================
-- MAIN HUB
--========================================

local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.fromOffset(300, 390)
frame.Position = UDim2.new(0.5, -150, 0.5, -195)
frame.BackgroundColor3 = Color3.fromRGB(13, 13, 13)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(90, 90, 90)
stroke.Thickness = 1.2
stroke.Parent = frame

--========================================
-- LOGO
--========================================

local logo = Instance.new("ImageLabel")
logo.Size = UDim2.fromOffset(115, 75)
logo.Position = UDim2.new(0.5, -57, 0, 5)
logo.BackgroundTransparency = 1
logo.Image = "rbxassetid://" .. LOGO_ID
logo.ScaleType = Enum.ScaleType.Fit
logo.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 28)
title.Position = UDim2.new(0, 0, 0, 85)
title.BackgroundTransparency = 1
title.Text = "SHAGS CURSOR HUB"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Active = true
title.Parent = frame

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, 0, 0, 20)
subtitle.Position = UDim2.new(0, 0, 0, 113)
subtitle.BackgroundTransparency = 1
subtitle.Text = "CUSTOMIZE YOUR CURSOR"
subtitle.TextColor3 = Color3.fromRGB(130, 130, 130)
subtitle.Font = Enum.Font.Gotham
subtitle.TextSize = 10
subtitle.Parent = frame

--========================================
-- DRAGGABLE HUB
-- Only the hub moves, not the cursor
--========================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
    end

end)

UIS.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )

    end

end)

UIS.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end

end)

--========================================
-- CUSTOM CURSOR
-- Follows the actual mouse position
--========================================

local cursor = Instance.new("ImageLabel")
cursor.Name = "SHAGS_CustomCursor"
cursor.Size = UDim2.fromOffset(36, 36)
cursor.AnchorPoint = Vector2.new(0.5, 0.5)
cursor.BackgroundTransparency = 1
cursor.BorderSizePixel = 0
cursor.Visible = false
cursor.Active = false
cursor.Selectable = false
cursor.ZIndex = 100
cursor.Parent = gui

local cursorConnection = RunService.RenderStepped:Connect(function()

    if cursor.Visible then

        local mousePosition = UIS:GetMouseLocation()

        cursor.Position = UDim2.fromOffset(
            mousePosition.X,
            mousePosition.Y
        )

    end

end)

--========================================
-- BUTTON FUNCTION
--========================================

local function createButton(name, position, color)

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -30, 0, 42)
    button.Position = UDim2.new(0, 15, 0, position)
    button.BackgroundColor3 = color
    button.BorderSizePixel = 0
    button.Text = name
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 13
    button.ZIndex = 2
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = button

    return button
end

--========================================
-- STATUS
--========================================

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -30, 0, 25)
status.Position = UDim2.new(0, 15, 0, 145)
status.BackgroundTransparency = 1
status.Text = "SELECT A CURSOR"
status.TextColor3 = Color3.fromRGB(160, 160, 160)
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.Parent = frame

--========================================
-- CURSOR SELECTION
--========================================

for i, data in ipairs(cursors) do

    local button = createButton(
        data.Name,
        180 + ((i - 1) * 50),
        Color3.fromRGB(38, 38, 38)
    )

    button.MouseButton1Click:Connect(function()

        selectedCursor = data.ID

        cursor.Image = "rbxassetid://" .. data.ID

        cursor.Visible = true
        UIS.MouseIconEnabled = false

        status.Text = "ACTIVE: " .. data.Name
        status.TextColor3 = Color3.fromRGB(230, 230, 230)

    end)

end

--========================================
-- RESTORE ORIGINAL CURSOR
--========================================

local restore = createButton(
    "RESTORE ORIGINAL CURSOR",
    290,
    Color3.fromRGB(65, 65, 65)
)

restore.MouseButton1Click:Connect(function()

    selectedCursor = nil

    cursor.Visible = false

    mouse.Icon = originalCursor
    UIS.MouseIconEnabled = originalMouseEnabled

    status.Text = "ORIGINAL CURSOR RESTORED"
    status.TextColor3 = Color3.fromRGB(180, 180, 180)

end)

--========================================
-- CLOSE HUB
--========================================

local close = createButton(
    "CLOSE HUB",
    340,
    Color3.fromRGB(100, 35, 35)
)

close.MouseButton1Click:Connect(function()
    frame.Visible = false
end)

--========================================
-- RIGHT SHIFT
--========================================

UIS.InputBegan:Connect(function(input, processed)

    if processed then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        frame.Visible = not frame.Visible
    end

end)

--========================================
-- CLEANUP
--========================================

gui.Destroying:Connect(function()

    cursorConnection:Disconnect()

    mouse.Icon = originalCursor
    UIS.MouseIconEnabled = originalMouseEnabled

end)

